PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/saree_db
BASE_URL=https://backendapis.srivinayakacollections.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://srivinayakacollections.com,https://admin.srivinayakacollections.com

# Upload tuning
UPLOAD_MAX_MB=100
UPLOAD_IMAGE_FORMAT=webp
UPLOAD_IMAGE_QUALITY=80
UPLOAD_IMAGE_MAX_WIDTH=1600
UPLOAD_IMAGE_MAX_HEIGHT=1600
UPLOAD_KEEP_ORIGINAL=false

# Payment Success/Failure Redirects
FRONTEND_URL=https://srivinayakacollections.com
